<?xml version="1.0" encoding="utf-8"?>
<!--
  surface_type is deliberate and can only be set here, not in code. PlayerView
  defaults to a SurfaceView, which is punched through the window and ignores any
  scale or translation applied by a parent - pinch-zoom would move the controls
  and leave the picture where it was. A TextureView is an ordinary view and
  transforms with everything else.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="true"
    app:show_buffering="when_playing"
    app:hide_on_touch="true" />
